{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isoziyuan-blog-lite",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-09-09",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isoziyuan-blog-lite-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
