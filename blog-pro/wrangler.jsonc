{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isoziyuan-blog-pro",
  "pages_build_output_dir": "client/dist",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isoziyuan-blog-pro-db",
      "database_id": "DATABASE_ID_PLACEHOLDER"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "isoziyuan-blog-media"
    }
  ]
}
